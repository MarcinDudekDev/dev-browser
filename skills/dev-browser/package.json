{
  "name": "dev-browser",
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "@/*": "./src/*"
  },
  "scripts": {
    "postinstall": "bash postinstall.sh",
    "start-server": "npx tsx builtins/start-server.ts",
    "dev": "npx tsx --watch src/index.ts",
    "test": "node --import tsx --test 'src/**/*.test.ts'",
    "test:watch": "node --import tsx --test --watch 'src/**/*.test.ts'"
  },
  "dependencies": {
    "express": "^4.21.0",
    "playwright": "^1.49.0",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.0.0"
  }
}
